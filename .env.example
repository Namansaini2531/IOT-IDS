# ===================================================
# IoT-IDS Configuration Settings
# ===================================================

# [Backend Settings]
PROJECT_NAME="IoT-IDS AI Defense Monitor"
API_V1_STR="/api/v1"
CORS_ORIGINS=["*"]

# Simulation replay interval (seconds)
REPLAY_INTERVAL_SECONDS=0.8

# [Groq AI Cyber Advisor Settings (Optional)]
# Add your free Groq API key (from https://console.groq.com/keys) to enable
# sub-second LPU reasoning with Llama-3.3-70B. If omitted, the system
# automatically operates in local heuristic rule-engine playbook mode.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# [Frontend Settings (Optional)]
# In Docker/Nginx or local dev, this defaults automatically.
# Set this if hosting frontend and backend on separate domains (e.g. Vercel + Render):
# VITE_API_BASE=https://your-backend-api.onrender.com/api/v1
